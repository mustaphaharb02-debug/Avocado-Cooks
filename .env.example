# Optional — the app already ships with working defaults for the
# "avo-cooks" Firebase project. Copy this file to `.env` only if you want
# to point the site at a different Firebase project or change who can
# open /admin.
#
# Anything prefixed with VITE_ is bundled into the public JavaScript, so
# never put private keys here. Firebase web config is public by design;
# access is controlled by firestore.rules / storage.rules.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Comma separated list of admin e-mails (must match firestore.rules)
VITE_ADMIN_EMAILS=mounahareb@gmail.com

# ---------------------------------------------------------------------
# Photo uploads (optional)
#
# Leave these empty to upload to Firebase Storage, which needs Storage
# enabled on the project (currently the Blaze plan).
#
# Fill them in to upload to Cloudinary instead — no Firebase billing
# needed. In Cloudinary: Settings > Upload > Upload presets > Add,
# set Signing Mode to UNSIGNED, and restrict it there: choose the
# folder on the preset, allow image formats only, cap the file size.
# Then copy the preset's name here.
#
# NEVER put your Cloudinary API secret in this file or anywhere in the
# project. Anything starting with VITE_ is published to every visitor.
# ---------------------------------------------------------------------
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
